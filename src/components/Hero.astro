---
const { title, subtitle } = Astro.props;
---

<div class="hero" data-hero>
  <div class="hero-bg" aria-hidden="true" data-hero-bg>
    <video data-intro-video muted playsinline preload="auto" webkit-playsinline></video>
  </div>

  <!-- fixed backdrop revealed after the intro: the still frame (avif) -->
  <img
    class="hero-still"
    alt=""
    data-still
    src="/assets/images/intro-desktop-response.avif"
  />

  <header class="site-header on-cream" data-site-header>
    <a class="nav-logo" href="/">{title}</a>
  </header>

  <div class="hero-inner">
    <h1>{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    <button class="discover-button" type="button" data-play-btn>
      <span>山中</span>
    </button>
  </div>
</div>

<script>
  const vid = document.querySelector("[data-intro-video]");
  const btn = document.querySelector("[data-play-btn]");
  const still = document.querySelector("[data-still]");
  const bg = document.querySelector("[data-hero-bg]");
  const header = document.querySelector("[data-site-header]");
  const body = document.body;
  const root = document.documentElement;

  const desktop = window.matchMedia("(min-width: 800px)").matches;
  const vSrc = desktop
    ? "/assets/videos/intro-desktop.webm"
    : "/assets/videos/intro-mobile.webm";
  const iSrc = desktop
    ? "/assets/images/intro-desktop-response.avif"
    : "/assets/images/intro-mobile-response.avif";

  vid.src = vSrc;
  still.src = iSrc;

  let started = false;
  let done = false;

  // gate: the articles below are hidden until the intro has played. Lock
  // scrolling (html + body) so you can't reach them from the start; unlock
  // when it ends.
  [root, body].forEach((el) => el.classList.add("is-locked"));

  function unlock() {
    [root, body].forEach((el) => el.classList.remove("is-locked"));
  }

  // preload the still so the cross-fade has no white flash
  const stillPromise = still.decode().catch(() => {});

  // starting backdrop = the video's first frame (paused at t=0), not a flat
  // colour. Gate on loadeddata (frame decoded) and seek to 0 so the bright
  // first frame paints; cream fallback sits underneath while it loads.
  vid.addEventListener("loadeddata", () => {
    vid.currentTime = 0;
    vid.pause();
    bg.classList.add("has-loaded");
  });

  function start() {
    if (started) return;
    started = true;
    btn.remove();
    header.classList.add("light"); // over the darker video scene
    body.classList.add("has-video");
    stillPromise.then(() => {
      vid.currentTime = 0;
      vid.play().catch(() => {});
    });
  }

  // cross-fade: fade the video out while the same-scene avif fades in beneath,
  // so the switch feels continuous with no hard cut.
  function onEnd() {
    if (done) return;
    done = true;
    vid.pause();
    bg.classList.add("has-ending");
    still.classList.add("is-visible");
    body.classList.remove("has-video");
    body.classList.add("has-still");
    unlock();
    // once fully faded out, stop rendering the video layer
    setTimeout(() => {
      bg.classList.remove("has-loaded");
      bg.classList.remove("has-ending");
    }, 1100);
  }

  btn.addEventListener("click", start);
  vid.addEventListener("ended", onEnd);
  // safety: if the video can't play, don't leave the page locked
  vid.addEventListener("error", unlock);
</script>
