---
const { title, subtitle } = Astro.props;
---

<div class="hero" data-hero>
  <div class="hero-bg" aria-hidden="true" data-hero-bg>
    <video data-intro-video muted playsinline preload="auto" webkit-playsinline></video>
  </div>

  <!-- fixed backdrop revealed after the intro: the still frame (avif, with
       jpg fallback for browsers that don't support AVIF, e.g. old Safari) -->
  <img
    class="hero-still"
    alt=""
    data-still
    src="/assets/images/intro-desktop-response.jpg"
  />

  <div class="hero-inner">
    <h1>{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    <button class="discover-button" type="button" data-play-btn>
      <span>山中</span>
    </button>
  </div>
</div>

<script>
  const vid = document.querySelector("[data-intro-video]");
  const btn = document.querySelector("[data-play-btn]");
  const still = document.querySelector("[data-still]");
  const bg = document.querySelector("[data-hero-bg]");
  const body = document.body;
  const root = document.documentElement;

  const desktop = window.matchMedia("(min-width: 800px)").matches;
  const base = desktop ? "desktop" : "mobile";
  const vWebm = `/assets/videos/intro-${base}.webm`;
  const vMp4 = `/assets/videos/intro-${base}.mp4`;
  const avif = `/assets/images/intro-${base}-response.avif`;
  const jpg = `/assets/images/intro-${base}-response.jpg`;

  // Prefer the still format the browser can actually decode (old Safari has
  // neither WebM nor AVIF; modern releases support both).
  const supports = (fmt) => {
    const img = new Image();
    const probe =
      fmt === "avif"
        ? "AAAAIGZ0eXBhdmlmAAAAAGFtYXZkaWdyZXMwbW9vcnAA"
        : "";
    img.src = `data:image/${fmt};base64,${probe}`;
    return img.decode && img.decode().then(() => true).catch(() => false);
  };

  const avifOk = supports("avif");

  const webmOk = vid.canPlayType && vid.canPlayType("video/webm") !== "";
  const mp4Ok = vid.canPlayType && vid.canPlayType("video/mp4") !== "";
  const webkitBrowser = /Safari|iPhone|iPad|iPod/.test(navigator.userAgent)
    && !/Chrome|CriOS|Edg|Android/.test(navigator.userAgent);

  // Safari is most reliable with the H.264 MP4 export. Chromium prefers the
  // smaller WebM, with MP4 retained as a runtime fallback if decoding fails.
  const chosen = webkitBrowser
    ? (mp4Ok ? vMp4 : webmOk ? vWebm : null)
    : (webmOk ? vWebm : mp4Ok ? vMp4 : null);
  let fallbackAttempted = false;

  if (chosen) vid.src = chosen;

  // still image: swap in AVIF only if decodable, else keep the jpg fallback
  avifOk.then((ok) => {
    still.src = ok ? avif : jpg;
  });

  let started = false;
  let done = false;
  let unlocked = false;

  function unlock() {
    if (unlocked) return;
    unlocked = true;
    [root, body].forEach((el) => el.classList.remove("is-locked"));
  }

  // Remember once the intro has been watched, and skip it on later visits
  // (e.g. returning to the homepage from an article) so the opening
  // cinematic only plays once ever per browser.
  const skipIntro = () => {
    try {
      return localStorage.getItem("intro_seen") === "1";
    } catch (_e) {
      return false;
    }
  };
  const markSeen = () => {
    try {
      localStorage.setItem("intro_seen", "1");
    } catch (_e) {}
  };

  // Skip the cinematic entirely if already seen: show the still directly,
  // hide the 山中 button and never lock scroll.
  if (skipIntro()) {
    btn.remove();
    bg.classList.add("has-ending");
    still.classList.add("is-visible");
    body.classList.add("has-still");
  } else {
    [root, body].forEach((el) => el.classList.add("is-locked"));

    // If the browser can't play the video at all, don't leave the page
    // locked: reveal the still immediately and unlock.
    if (chosen === null) {
      unlock();
      bg.classList.add("has-ending");
      still.classList.add("is-visible");
      body.classList.add("has-still");
    } else {
      // starting backdrop = the video's first frame (paused at t=0). Gate on
      // loadeddata (frame decoded) and seek to 0 so the first frame paints;
      // cream fallback sits underneath while it loads.
      vid.addEventListener("loadeddata", () => {
        if (started) return;
        vid.currentTime = 0;
        vid.pause();
        bg.classList.add("has-loaded");
      });

    function start() {
      if (started) return;
      started = true;
      btn.remove();
      body.classList.add("has-video");
      // Keep play() inside the click handler. Safari rejects a play request
      // moved into a promise callback because it no longer has user intent.
      vid.currentTime = 0;
      const playRequest = vid.play();
      if (playRequest && typeof playRequest.catch === "function") {
        playRequest.catch(onEnd);
      }
    }

    function onEnd() {
      if (done) return;
      done = true;
      vid.pause();
      markSeen();
      bg.classList.add("has-ending");
      still.classList.add("is-visible");
      body.classList.remove("has-video");
      body.classList.add("has-still");
      unlock();
      setTimeout(() => {
        bg.classList.remove("has-loaded");
        bg.classList.remove("has-ending");
      }, 1100);
    }

    btn.addEventListener("click", start);
    vid.addEventListener("ended", onEnd);
    // safety: if the video errors out, never leave the page locked
    vid.addEventListener("error", () => {
      if (!fallbackAttempted && vid.src.endsWith(vWebm) && mp4Ok) {
        fallbackAttempted = true;
        vid.src = vMp4;
        vid.load();
        if (started) vid.play().catch(onEnd);
        return;
      }
      onEnd();
    });
    }

    // last-resort: if the video stalls/hangs for whatever reason, unlock anyway
    setTimeout(unlock, 20000);
  }
</script>
