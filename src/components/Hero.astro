---
const { title, subtitle } = Astro.props;
---

<div class="hero" data-hero>
  <div class="hero-bg" aria-hidden="true" data-hero-bg>
    <video data-intro-video muted playsinline preload="auto" webkit-playsinline></video>
    <div class="hero-scanlines"></div>
  </div>

  <header class="site-header" data-site-header>
    <a class="nav-logo" href="/">{title}</a>
    <nav class="nav-actions" aria-label="Primary">
      <a href="/#posts">Articles</a>
      <a href="/#about">About</a>
    </nav>
  </header>

  <div class="hero-inner">
    <h1>{title}</h1>
    {subtitle && <p class="sub">{subtitle}</p>}
    <button class="discover-button" type="button" data-play-btn>
      <span>Watch intro</span>
    </button>
  </div>
</div>

<script>
  const vid = document.querySelector("[data-intro-video]");
  const btn = document.querySelector("[data-play-btn]");
  const hero = document.querySelector("[data-hero]");
  const bg = document.querySelector("[data-hero-bg]");
  const header = document.querySelector("[data-site-header]");

  const desktop = window.matchMedia("(min-width: 800px)");
  const isMobile = !desktop.matches;
  vid.src = desktop.matches
    ? "/assets/videos/intro-desktop.webm"
    : "/assets/videos/intro-mobile.webm";

  let played = false;

  function start() {
    if (played) {
      // already played once -> keep its last frame as the fixed background
      return;
    }
    played = true;
    // header sits over the video -> flip to light color for legibility
    header.classList.add("light");
    btn.style.display = "none";
    bg.classList.add("is-fixed");
    vid.classList.add("is-playing");
    vid.play().catch(() => {});
  }

  btn.addEventListener("click", start);

  // pause on the final frame -> it becomes the blog backdrop while scrolling
  vid.addEventListener("ended", () => {
    vid.pause();
  });

  // catch a light swipe: also let the intro play once scrolled is not needed
  if (isMobile) {
    header.classList.remove("light");
  }
</script>
