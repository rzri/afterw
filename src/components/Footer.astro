---
const { overlay = false } = Astro.props;
const footerClass = overlay ? "contact-footer contact-footer--overlay" : "contact-footer";
---

<footer class={footerClass} aria-label="页脚">
  <div class="footer-inner">
    <div class="footer-heading">
      <p class="footer-kicker">随手记 · 慢慢写</p>
      <a class="footer-brand" href="/">本心自昭</a>
    </div>

    <nav class="footer-links" aria-label="站点链接">
      <a href="/">首页 <span aria-hidden="true">↗</span></a>
      <a href="/#about">小序 <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/rzri" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
      <a href="mailto:haenlau.me@gmail.com">联系我 <span aria-hidden="true">↗</span></a>
    </nav>
  </div>

  <div class="footer-meta">
    <span>© {new Date().getFullYear()} 本心自昭</span>
    <span>MADE BY rzri</span>
  </div>
</footer>
