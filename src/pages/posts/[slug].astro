---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      previous: posts[posts.indexOf(post) + 1] ?? null,
      next: posts[posts.indexOf(post) - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await post.render();

const fmt = (d) =>
  new Date(d)
    .toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
    .replace(/\//g, "年")
    .replace(/(\d+)年(\d+)月(\d+)日/, "$1年$2月$3日");
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
>
  <article class="article">
    <div class="art-inner">
      <p class="article-meta">
        <time>{fmt(post.data.pubDate)}</time>
      </p>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
      {(previous || next) && (
        <nav class="article-pagination" aria-label="文章导航">
          {previous ? (
            <a class="article-pagination-link" href={`/posts/${previous.slug}/`} rel="prev">
              <span class="article-pagination-label">上一篇</span>
              <span class="article-pagination-title">{previous.data.title}</span>
            </a>
          ) : <span aria-hidden="true" />}
          {next ? (
            <a class="article-pagination-link article-pagination-link--next" href={`/posts/${next.slug}/`} rel="next">
              <span class="article-pagination-label">下一篇</span>
              <span class="article-pagination-title">{next.data.title}</span>
            </a>
          ) : <span aria-hidden="true" />}
        </nav>
      )}
    </div>
  </article>
</Base>
