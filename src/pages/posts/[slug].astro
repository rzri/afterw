---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/format";
import { SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      previous: posts[posts.indexOf(post) + 1] ?? null,
      next: posts[posts.indexOf(post) - 1] ?? null,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await post.render();
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
>
  <header class="site-header">
    <nav class="site-nav">
      <a class="nav-logo" href="/">{SITE_TITLE}</a>
      <div class="nav-actions">
        <a href="/#posts">小记</a>
        <a href="/#about">小序</a>
      </div>
    </nav>
  </header>
  <article class="article">
    <div class="art-inner">
      <p class="article-meta">
        <time>{formatDate(post.data.pubDate)}</time>
      </p>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
      {(previous || next) && (
        <nav class="article-pagination" aria-label="文章导航">
          {previous ? (
            <a class="article-pagination-link" href={`/posts/${previous.slug}/`} rel="prev">
              <span class="article-pagination-label">上一篇</span>
              <span class="article-pagination-title">{previous.data.title}</span>
            </a>
          ) : <span aria-hidden="true" />}
          {next ? (
            <a class="article-pagination-link article-pagination-link--next" href={`/posts/${next.slug}/`} rel="next">
              <span class="article-pagination-label">下一篇</span>
              <span class="article-pagination-title">{next.data.title}</span>
            </a>
          ) : <span aria-hidden="true" />}
        </nav>
      )}
    </div>
  </article>
</Base>
