---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import PostList from "../components/PostList.astro";

export async function getStaticPaths({ paginate }) {
  const allPosts = (
    await getCollection("posts", ({ data }) => !data.draft)
  ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(allPosts, { pageSize: 6 });
}

const { page } = Astro.props;
const isFirst = page.currentPage === 1;
const subtitle = "荆溪白石出，天寒红叶稀。\n山路元无雨，空翠湿人衣。";
---

<Base bodyClass={isFirst ? "shoujin" : ""}>
  {isFirst && <Hero title="本心自昭" subtitle={subtitle} />}

  <main class="sbw-body">
    <PostList posts={page.data} page={page} />

    {isFirst && (
      <section class="list" id="about">
        <div class="wrap">
          <h1 class="list-heading">小序</h1>
          <div class="prose" style="max-width:44rem;white-space:pre-line">
春日种瓜，夏夜乘凉，秋晨扫落叶，冬日晒太阳。
花的开落，云的来去，一日三餐，几页闲书。
人生足矣。
      </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Base>
