---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d) =>
  new Date(d)
    .toLocaleDateString("zh-CN", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
    .replace(/\//g, "年")
    .replace(/(\d+)年(\d+)月(\d+)日/, "$1年$2月$3日");

const subtitle = "荆溪白石出，天寒红叶稀。\n山路元无雨，空翠湿人衣。";
---

<Base bodyClass="shoujin">
  <Hero title="本心自昭" subtitle={subtitle} />

  <main class="sbw-body">
    <section class="list first" id="posts">
      <div class="wrap">
        <h1 class="list-heading">小记</h1>
        <ol class="post-list">
          {allPosts.map((p) => (
            <li class="post-item">
              <a href={`/posts/${p.slug}/`}>
                <div class="post-row">
                  <h2>{p.data.title}</h2>
                  <time class="post-date">{fmt(p.data.pubDate)}</time>
                </div>
                {p.data.description && (
                  <p class="post-excerpt">{p.data.description}</p>
                )}
                {(p.data.tags?.length ?? 0) > 0 && (
                  <ul class="post-tags">
                    {p.data.tags.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="list" id="about">
      <div class="wrap">
        <h1 class="list-heading">小序</h1>
        <div class="prose" style="max-width:44rem;white-space:pre-line">
春日种瓜，夏夜乘凉，秋晨扫落叶，冬日晒太阳。
花的开落，云的来去，一日三餐，几页闲书。
人生足矣。
      </div>
    </section>
  </main>

  <footer class="contact-footer">
    <div class="foot-grid">
      <div class="foot-brand">本心自昭</div>
      <div class="foot-cols">
        <div class="foot-col">
          <h4>Links</h4>
          <a href="https://github.com/rzri" target="_blank" rel="noopener">
            GitHub
          </a>
          <a href="mailto:haenlau.me@gmail.com">Email</a>
        </div>
      </div>
    </div>
    <div class="footer-meta">
      <span>© {new Date().getFullYear()} 本心自昭</span>
      <span>MADE BY rzri</span>
    </div>
  </footer>
</Base>
