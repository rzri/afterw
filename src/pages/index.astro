---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";

const allPosts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d) =>
  new Date(d).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<Base>
  <Hero
    title="innatus"
    subtitle="notes, ideas & experiments worth returning to"
  />

  <main id="main">
    <section class="list" id="posts">
      <div class="wrap">
        <h1 class="list-heading">Writing</h1>
        <ol class="post-list">
          {allPosts.map((p) => (
            <li>
              <a href={`/posts/${p.slug}/`}>
                <div class="post-row">
                  <h2>{p.data.title}</h2>
                  <time class="date">{fmt(p.data.pubDate)}</time>
                </div>
                {p.data.description && (
                  <p class="excerpt">{p.data.description}</p>
                )}
                {(p.data.tags?.length ?? 0) > 0 && (
                  <ul class="tags">
                    {p.data.tags.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="list" id="about" style="padding-top:0">
      <div class="wrap">
        <h1 class="list-heading">About</h1>
        <div class="prose">
          <p>
            innatus is a personal blog for notes, projects, and small
            experiments. Every entry here is a thing I found worth returning
            to.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="foot-grid">
        <div class="brand">innatus</div>
        <div class="col">
          <h4>Links</h4>
          <a href="https://github.com/rzri" target="_blank" rel="noopener">
            GitHub
          </a>
          <a href="mailto:haenlau.me@gmail.com">Email</a>
        </div>
        <div class="col">
          <h4>Colophon</h4>
          <span>Astro · dark purple &amp; cream</span>
        </div>
      </div>
      <div class="foot-meta">
        <span>© {new Date().getFullYear()} innatus</span>
        <span>MADE BY rzri</span>
      </div>
    </div>
  </footer>
</Base>
