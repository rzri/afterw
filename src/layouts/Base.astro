---
import "../styles/global.css";

const { title = "本心自昭", bodyClass = "" } = Astro.props;
const pageTitle = title === "本心自昭" ? "本心自昭" : `${title} · 本心自昭`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <meta name="generator" content="Astro" />
    <meta name="description" content="本心自昭 — a personal blog. Dark purple and cream, with a cinematic WebM introduction." />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/png" href="/assets/images/icon-128x128.png" />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      // mimic original --sbw scrollbar compensation
      const update = () =>
        document.documentElement.style.setProperty(
          "--sbw",
          `${window.innerWidth - document.documentElement.clientWidth}px`
        );
      update();
      window.addEventListener("resize", update);

      // Pagination links target #posts, but that jump should be immediate so
      // the next page opens on the article list instead of animating through
      // the Hero scene like a manual scroll.
      if (window.location.hash === "#posts") {
        document.documentElement.style.scrollBehavior = "auto";
        window.addEventListener("load", () => {
          document.getElementById("posts")?.scrollIntoView({
            behavior: "auto",
            block: "start",
          });
        }, { once: true });
      }
    </script>
  </body>
</html>
